# Copy to .env for local overrides. Never commit .env.
# Relay reads these environment variables at startup; none are secrets
# in the default local setup.

# Path to the route configuration file.
RELAY_CONFIG=config/routes.yaml

# Overrides redis.url from the YAML file (e.g. redis://localhost:6379/0).
# If Redis needs a password in your environment, put it here, not in YAML:
# RELAY_REDIS_URL=redis://:change-me@localhost:6379/0
RELAY_REDIS_URL=

# Logging
RELAY_LOG_LEVEL=INFO
RELAY_LOG_JSON=true

# Grafana admin password for the local Compose stack.
GRAFANA_ADMIN_PASSWORD=change-me-locally
